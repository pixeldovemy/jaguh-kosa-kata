function startGame() {
const nameInput = document.getElementById('player-name').value.trim();
if (nameInput === "") { alert("Masukkan nama dulu bro!"); return; }

// Simpan data ke LocalStorage
localStorage.setItem('ai_game_name', nameInput);
localStorage.setItem('ai_game_avatar', chosenAvatar);
localStorage.setItem('ai_game_level', 0);
localStorage.setItem('ai_game_score', 0);

renderProfile(nameInput, chosenAvatar);
document.getElementById('startup-page').style.display = 'none';
document.getElementById('game-page').style.display = 'flex';
initClues();
}

// Fungsi bantuan untuk paparkan profil
function renderProfile(name, avatar) {
document.getElementById('display-name').innerText = name;
document.getElementById('display-avatar').innerText = avatar;
}
```

### 2. Update Function `checkAnswer`
Cari bahagian di dalam `if (answer === gameData[currentLevel].word)`, tambahkan baris untuk update level dan score ke LocalStorage:

