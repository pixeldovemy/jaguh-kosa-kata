<button onclick="showQuitPage()" style="background: #ff4757; color: white; border: none; border-radius: 50%; width: 28px; height: 28px; cursor: pointer;">✕</button>
</div>
</div>
<div style="font-size: 10px; color: #a29bfe; font-weight: bold; text-transform: uppercase; margin-bottom: 5px;" id="level-text">LEVEL 1</div>
<p id="game-question">Memuatkan...</p>
<div class="video-wrapper"><video id="game-video" autoplay loop muted playsinline><source id="video-source" src="" type="video/mp4"></video></div>
<div class="tab-container">
<button id="btn-tab-q" class="tab-btn" onclick="toggleTab('q')">Contoh Soalan</button>
<button id="btn-tab-h" class="tab-btn" onclick="toggleTab('h')">Perlu Klu?</button>
</div>
<div id="tab-content" class="tab-content-area"></div>
<input type="text" id="user-input" placeholder="Taip jawapan..." autocomplete="off">
<div class="hint-section">
<div class="hint-list" id="clue-list"></div>
</div>
<button class="btn-main btn-submit" onclick="checkAnswer()">HANTAR 🚀</button>
<p id="result" style="min-height:20px; font-weight:bold; margin-top:10px;"></p>
</div>

<!-- MODALS -->
<div id="quit-page"><div class="container"><h1>🥺</h1><h2>Nak berhenti?</h2><button class="btn-main" onclick="continueGame()">SAMBUNG 🔥</button><button class="btn-main btn-alt" onclick="renderMap()">PETA LEVEL</button></div></div>
<div id="reset-modal"><div class="container"><h1>⚠️</h1><h2>Reset Permainan?</h2><p style="font-size:14px; color:#666;">Semua koin dan level akan dipadamkan!</p><button class="btn-main" onclick="confirmReset()" style="background:#ff4757;">YA, RESET</button><button class="btn-main btn-alt" onclick="closeResetModal()">TIDAK</button></div></div>

<!-- Audio -->
<audio id="snd-kaching" src="https://assets.mixkit.co/active_storage/sfx/2017/2017-preview.mp3"></audio>
<audio id="snd-aww" src="https://assets.mixkit.co/active_storage/sfx/251/251-preview.mp3"></audio>

<script>
let score = 0, currentLevel = 0, maxLevelReached = 0, chosenAvatar = "🤖", activeTab = null;

const ranks = [
{ title: "Pelajar Tekun 🎓", range: [1, 50] },
{ title: "Peneroka Pintar 🧭", range: [51, 100] },
{ title: "Pengembara Gigih 🗺️", range: [101, 150] },
{ title: "Perajurit Perkasa 🛡️", range: [151, 200] },
{ title: "Panglima Gagah ⚔️", range: [201, 250] },
{ title: "Pujangga Kreatif ✒️", range: [251, 300] },
{ title: "Cendekia Bijaksana 🧠", range: [301, 350] },
{ title: "Sarjana Arif 📚", range: [351, 400] },
{ title: "Ilmuwan Terbilang 🏅", range: [401, 450] },
{ title: "Jaguh Ulung 🏆", range: [451, 500] }
];

// 500 LEVEL DATA GENERATOR
const gameData = [];
gameData.push({ word: "menebar", vid: "videos/menebar.mp4", q: "Aksi apakah yang dilakukan terhadap doh ini?", example: "Ahmad mahir _______ doh roti canai di warung.", h: "Guna tepung & pusing-pusing." });
for (let i = 2; i <= 500; i++) {
gameData.push({ word: `jawapan${i}`, vid: `videos/clip${i}.mp4`, q: `Teka aksi Level ${i}?`, example: `Lorem ipsum _______ level ${i}.`, h: `Klu Lorem Ipsum Level ${i}` });
}

window.onload = function() {
const name = localStorage.getItem('jaguh_name');
if (name) {
maxLevelReached = parseInt(localStorage.getItem('jaguh_max')) || 0;
showDashboard();
} else { showPage('startup-page'); }
};

function showPage(id) {
['startup-page', 'dashboard-page', 'map-page', 'game-page', 'quit-page', 'reset-modal'].forEach(p => document.getElementById(p).style.display = 'none');
const el = document.getElementById(id);
el.style.display = (id === 'quit-page' || id === 'reset-modal') ? 'flex' : 'block';
}

function renderMap() {
const mapArea = document.getElementById('map-area');
mapArea.innerHTML = "";
ranks.forEach(rank => {
let section = document.createElement('div'); section.className = "map-section";
section.innerHTML = `<div class="map-section-title"><span>${rank.title}</span><span style="font-size:10px;">LV ${rank.range[0]}-${rank.range[1]}</span></div>`;
let grid = document.createElement('div'); grid.className = "level-grid";
for (let l = rank.range[0]; l <= rank.range[1]; l++) {
let node = document.createElement('div');
node.className = "level-node";
node.innerText = l;
if (l <= maxLevelReached + 1) {
node.classList.add('unlocked');
if (l === maxLevelReached + 1) node.classList.add('current');
node.onclick = () => startLevel(l - 1);
}
grid.appendChild(node);
}
section.appendChild(grid);
mapArea.appendChild(section);
});
showPage('map-page');
}

function startLevel(idx) {
currentLevel = idx;
score = parseInt(localStorage.getItem('jaguh_score')) || 0;
document.getElementById('game-name').innerText = localStorage.getItem('jaguh_name');
document.getElementById('game-avatar').innerText = localStorage.getItem('jaguh_avatar');
document.getElementById('score').innerText = score;
loadLevel(currentLevel);
initClues();
showPage('game-page');
}

function loadLevel(idx) {
const data = gameData[idx];
document.getElementById('level-text').innerText = `LEVEL ${idx + 1}`;
document.getElementById('game-question').innerText = data.q;
document.getElementById('video-source').src = data.vid;
document.getElementById('game-video').load();
closeTabs();
}

function toggleTab(type) {
const area = document.getElementById('tab-content');
const data = gameData[currentLevel];
if (activeTab === type) { closeTabs(); }
else {
area.style.display = 'block'; activeTab = type;
if (type === 'q') {
// Logic: Jika dah pernah settle level ni, tunjuk jawapan terus
let sentence = data.example;
if (currentLevel < maxLevelReached) {
sentence = sentence.replace("_______", `<span style="color:#6c5ce7; text-decoration:underline;">${data.word}</span>`);
}
area.innerHTML = `<b>Contoh Soalan:</b><br>"${sentence}"`;
} else { area.innerHTML = `<b>Klu:</b><br>${data.h}`; }
document.getElementById('btn-tab-q').classList.toggle('active', type === 'q');
document.getElementById('btn-tab-h').classList.toggle('active', type === 'h');
}
}

function checkAnswer() {
const input = document.getElementById('user-input');
const res = document.getElementById('result');
const ans = input.value.toLowerCase().replace(/[^a-zA-Z0-9 ]/g, "").trim();

if (ans === gameData[currentLevel].word) {
document.getElementById('snd-kaching').play();
confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
spawnCoin();
res.innerText = "BETUL! 💰"; res.style.color = "#2ed573";

if (currentLevel === maxLevelReached) {
maxLevelReached++;
localStorage.setItem('jaguh_max', maxLevelReached);
}
score += 10;
localStorage.setItem('jaguh_score', score);

setTimeout(() => {
input.value = ""; res.innerText = "";
renderMap();
}, 1500);
} else {
document.getElementById('snd-aww').play();
res.innerText = "SALAH! 🙊"; res.style.color = "#ff4757";
document.getElementById('game-box').classList.add('shake');
setTimeout(() => document.getElementById('game-box').classList.remove('shake'), 500);
}
}

function sanitize(text) { return text.replace(/[^a-zA-Z0-9 ]/g, "").trim(); }
function saveAndStart() {
const n = sanitize(document.getElementById('player-name').value);
if(!n) return alert("Sila letak nama!");
localStorage.setItem('jaguh_name', n);
localStorage.setItem('jaguh_avatar', chosenAvatar);
localStorage.setItem('jaguh_max', 0);
localStorage.setItem('jaguh_score', 0);
maxLevelReached = 0; startLevel(0);
}
function selectAvatar(el, a) {
chosenAvatar = a;
document.querySelectorAll('.avatar-item').forEach(i => i.style.border = "none");
el.style.border = "3px solid #6c5ce7";
}
function showDashboard() {
document.getElementById('dash-name').innerText = localStorage.getItem('jaguh_name');
document.getElementById('dash-avatar').innerText = localStorage.getItem('jaguh_avatar');
document.getElementById('dash-level').innerText = maxLevelReached + 1;
document.getElementById('dash-score').innerText = localStorage.getItem('jaguh_score') || 0;
document.getElementById('dash-gelaran').innerText = getGelaran(maxLevelReached + 1);
showPage('dashboard-page');
}
function getGelaran(l) { for (let r of ranks) { if (l <= r.range[1]) return r.title; } return "Jaguh Ulung 🏆"; }
function initClues() {
const list = document.getElementById('clue-list');
list.innerHTML = "";
const allWords = gameData.map(d => d.word).sort((a,b) => a.localeCompare(b));
allWords.slice(0, 20).forEach(w => { // Papar 20 perkataan pertama sebagai contoh
let s = document.createElement('span'); s.className = 'hint-item'; s.innerText = w; list.appendChild(s);
});
}
function closeTabs() { document.getElementById('tab-content').style.display = 'none'; activeTab = null; document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active')); }
function showQuitPage() { document.getElementById('quit-page').style.display = 'flex'; }
function continueGame() { document.getElementById('quit-page').style.display = 'none'; }
function openResetModal() { document.getElementById('reset-modal').style.display = 'flex'; }
function closeResetModal() { document.getElementById('reset-modal').style.display = 'none'; }
function confirmReset() { localStorage.clear(); location.reload(); }
function spawnCoin() {
const coin = document.createElement('div'); coin.className = 'coin-anim'; coin.innerText = '🪙'; document.body.appendChild(coin);
const v = document.getElementById('game-video').getBoundingClientRect();
coin.style.left = (v.left + v.width/2 - 20) + 'px'; coin.style.top = (v.top + v.height/2 - 20) + 'px';
const d = document.getElementById('score-container').getBoundingClientRect();
setTimeout(() => { coin.style.left = d.left + 'px'; coin.style.top = d.top + 'px'; coin.style.transform = 'scale(0.2)'; coin.style.opacity = '0'; }, 50);
setTimeout(() => coin.remove(), 800);
}
document.getElementById('user-input').addEventListener('keypress', (e) => { if (e.key === 'Enter') checkAnswer(); });
</script>
</body>
</html>
```

### Checklist Kejayaan Version 3.5:
1. Daftar Hero: Lepas daftar nama & avatar, dia terus bawa kau ke Level 1.
2. Dashboard: Kalau kau buka balik web, butang Sambung Main akan bawa kau ke Peta Level.
3. Peta Level: Ada 500 level. Level 1 mula-mula *unlocked*, yang lain semua *locked* (kelabu). Bila kau settle Level 1, Level 2 akan automatik jadi putih dan boleh diklik.
4. Replay Mode: Cuba main Level 1, pastu menang. Lepas tu klik balik Level 1 kat peta, buka tab Contoh Soalan. Kau akan nampak perkataan `"menebar"` dah siap-siap ada dalam ayat tu.
5. Audio & VFX: Bunyi kaching, koin terbang, dan bunga api tetap "meletup" macam biasa!

