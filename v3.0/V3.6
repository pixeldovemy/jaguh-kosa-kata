// Utils
function fireworks() {
var duration = 2.5 * 1000;
var animationEnd = Date.now() + duration;
var interval = setInterval(function() {
var timeLeft = animationEnd - Date.now();
if (timeLeft <= 0) return clearInterval(interval);
confetti({ particleCount: 40, origin: { x: Math.random(), y: Math.random() - 0.2 } });
}, 250);
}

function spawnCoin() {
const coin = document.createElement('div');
coin.className = 'coin-anim';
coin.innerText = '🪙';
document.body.appendChild(coin);
const startRect = document.getElementById('game-video').getBoundingClientRect();
coin.style.left = (startRect.left + startRect.width / 2 - 20) + 'px';
coin.style.top = (startRect.top + startRect.height / 2 - 20) + 'px';
const destRect = document.getElementById('score-container').getBoundingClientRect();
setTimeout(() => {
coin.style.left = destRect.left + 'px';
coin.style.top = destRect.top + 'px';
coin.style.transform = 'scale(0.3) rotate(1080deg)';
coin.style.opacity = '0';
}, 50);
setTimeout(() => {
score += 10;
document.getElementById('score').innerText = score;
document.getElementById('score-container').classList.add('bump');
setTimeout(() => document.getElementById('score-container').classList.remove('bump'), 200);
coin.remove();
}, 850);
}

document.getElementById('user-input').addEventListener('keypress', (e) => { if (e.key === 'Enter') checkAnswer(); });
</script>
