document.getElementById('dash-level').innerText = level + 1;
document.getElementById('dash-score').innerText = localStorage.getItem('jaguh_score');
document.getElementById('dash-gelaran').innerText = getGelaran(level + 1);
showPage('dashboard-page');
}

function goToGame() {
currentLevel = parseInt(localStorage.getItem('jaguh_level')) || 0;
score = parseInt(localStorage.getItem('jaguh_score')) || 0;
document.getElementById('game-name').innerText = localStorage.getItem('jaguh_name');
document.getElementById('game-avatar').innerText = localStorage.getItem('jaguh_avatar');
document.getElementById('score').innerText = score;
loadLevel(currentLevel);
initClues();
showPage('game-page');
}

function checkAnswer() {
const inputField = document.getElementById('user-input');
const res = document.getElementById('result');

// SANITIZE USER ANSWER
const userAnswer = sanitize(inputField.value).toLowerCase();

if (userAnswer === gameData[currentLevel].word) {
document.getElementById('snd-kaching').play();
spawnCoin(); fireworks();
res.innerText = "BETUL! 💰"; res.style.color = "#2ed573";
score += 10; currentLevel++;
localStorage.setItem('jaguh_score', score);
localStorage.setItem('jaguh_level', currentLevel);
setTimeout(() => {
if (currentLevel < 20) { loadLevel(currentLevel); inputField.value = ""; res.innerText = ""; document.getElementById('score').innerText = score; }
else { alert("ANDA JAGUH ULUNG!"); exitToDashboard(); }
}, 1500);
} else {
document.getElementById('snd-aww').play();
res.innerText = "SALAH! 🙊"; res.style.color = "#ff4757";
document.getElementById('game-box').classList.add('shake');
setTimeout(() => document.getElementById('game-box').classList.remove('shake'), 500);
}
}

// UI HELPERS
function loadLevel(idx) {
if(idx >= gameData.length) return;
document.getElementById('level-text').innerText = `LEVEL ${idx + 1}/20`;
document.getElementById('game-question').innerText = gameData[idx].q;
document.getElementById('tab-content').style.display = 'none';
document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
activeTab = null;
document.getElementById('video-source').src = gameData[idx].vid;
document.getElementById('game-video').load();
}

function toggleTab(type) {
const area = document.getElementById('tab-content');
const data = gameData[currentLevel];
if (activeTab === type) { area.style.display = 'none'; activeTab = null; }
else {
area.style.display = 'block'; activeTab = type;
area.innerHTML = type === 'q' ? `<b>Ayat Contoh:</b><br>"${data.example}"` : `<b>Klu:</b><br>${data.h}`;
document.getElementById('btn-tab-q').className = type === 'q' ? 'tab-btn active' : 'tab-btn';
document.getElementById('btn-tab-h').className = type === 'h' ? 'tab-btn active' : 'tab-btn';
}
}

function initClues() {
const list = document.getElementById('clue-list');
list.innerHTML = "";
const allWords = gameData.map(d => d.word).sort((a, b) => a.localeCompare(b));
allWords.forEach(w => { let s = document.createElement('span'); s.className = 'hint-item'; s.innerText = w; list.appendChild(s); });
}

function showPage(id) {
['startup-page', 'dashboard-page', 'game-page', 'quit-page', 'reset-modal'].forEach(p => document.getElementById(p).style.display = 'none');
const el = document.getElementById(id);
el.style.display = (id === 'quit-page' || id === 'reset-modal') ? 'flex' : 'block';
}

function selectAvatar(el, avatar) { document.querySelectorAll('.avatar-item').forEach(i => i.classList.remove('selected')); el.classList.add('selected'); chosenAvatar = avatar; }
function showQuitPage() { document.getElementById('quit-page').style.display = 'flex'; }
function continueGame() { document.getElementById('quit-page').style.display = 'none'; }
function exitToDashboard() { showDashboard(); }
function openResetModal() { document.getElementById('reset-modal').style.display = 'flex'; }
function closeResetModal() { document.getElementById('reset-modal').style.display = 'none'; }
function confirmReset() { localStorage.clear(); location.reload(); }
function fireworks() { confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } }); }
function spawnCoin() {
const coin = document.createElement('div'); coin.className = 'coin-anim'; coin.innerText = '🪙'; document.body.appendChild(coin);
const v = document.getElementById('game-video').getBoundingClientRect();
coin.style.left = (v.left + v.width/2 - 20) + 'px'; coin.style.top = (v.top + v.height/2 - 20) + 'px';
const d = document.getElementById('score-container').getBoundingClientRect();
setTimeout(() => { coin.style.left = d.left + 'px'; coin.style.top = d.top + 'px'; coin.style.transform = 'scale(0.2)'; coin.style.opacity = '0'; }, 50);
setTimeout(() => { document.getElementById('score-container').style.transform = 'scale(1.1)'; setTimeout(()=>document.getElementById('score-container').style.transform='scale(1)', 100); coin.remove(); }, 800);
}
document.getElementById('user-input').addEventListener('keypress', (e) => { if (e.key === 'Enter') checkAnswer(); });
</script>
</body>
</html>
```

