<!-- PAGE 3: QUIT PAGE -->
<div id="quit-page">
<div class="container">
<h1 style="font-size: 50px; margin: 0;">🥺</h1>
<h2>Nak berhenti ke?</h2>
<p>Progress anda disimpan secara automatik.</p>
<button class="btn-main" onclick="continueGame()" style="margin-bottom: 10px;">SAMBUNG MAIN 🔥</button>
<button class="btn-main" onclick="resetGame()" style="background: #95a5a6; box-shadow: 0 8px 0 #7f8c8d;">PADAM & MULA BARU</button>
</div>
</div>

<audio id="snd-kaching" src="https://assets.mixkit.co/active_storage/sfx/2017/2017-preview.mp3"></audio>
<audio id="snd-aww" src="https://assets.mixkit.co/active_storage/sfx/251/251-preview.mp3"></audio>

<script>
let chosenAvatar = "🤖";
let score = 0;
let currentLevel = 0;
const correctSound = document.getElementById('snd-kaching');
const wrongSound = document.getElementById('snd-aww');
correctSound.volume = 0.5; wrongSound.volume = 0.4;

const gameData = [];
gameData.push({ word: "menebar", vid: "videos/menebar.mp4" });
for (let i = 2; i <= 20; i++) {
gameData.push({ word: `jawapan${i}`, vid: `videos/clip${i}.mp4` });
}

// LOAD PROGRESS DARI LOCALSTORAGE
window.onload = function() {
const savedName = localStorage.getItem('ai_name');
const savedAvatar = localStorage.getItem('ai_avatar');
const savedLevel = localStorage.getItem('ai_level');
const savedScore = localStorage.getItem('ai_score');

if (savedName && savedLevel) {
currentLevel = parseInt(savedLevel);
score = parseInt(savedScore);
chosenAvatar = savedAvatar;

document.getElementById('display-name').innerText = savedName;
document.getElementById('display-avatar').innerText = chosenAvatar;
document.getElementById('score').innerText = score;
loadLevel(currentLevel);

document.getElementById('startup-page').style.display = 'none';
document.getElementById('game-page').style.display = 'flex';
initClues();
}
};

function selectAvatar(el, avatar) {
document.querySelectorAll('.avatar-item').forEach(item => item.classList.remove('selected'));
el.classList.add('selected');
chosenAvatar = avatar;
}

function startGame() {
const nameInput = document.getElementById('player-name').value.trim();
if (nameInput === "") { alert("Masukkan nama dulu!"); return; }

localStorage.setItem('ai_name', nameInput);
localStorage.setItem('ai_avatar', chosenAvatar);
localStorage.setItem('ai_level', 0);
localStorage.setItem('ai_score', 0);

location.reload(); // Refresh untuk load state baru
}

function initClues() {
const clueList = document.getElementById('clue-list');
clueList.innerHTML = "";
gameData.forEach(item => {
let span = document.createElement('span');
span.className = 'hint-item';
span.innerText = item.word;
clueList.appendChild(span);
});
}

function loadLevel(levelIndex) {
if (levelIndex < gameData.length) {
document.getElementById('level-text').innerText = `LEVEL ${levelIndex + 1}/20`;
document.getElementById('video-source').src = gameData[levelIndex].vid;
document.getElementById('game-video').load();
}
}

function checkAnswer() {
const inputField = document.getElementById('user-input');
const resultText = document.getElementById('result');
let answer = inputField.value.toLowerCase().trim();

if (answer === gameData[currentLevel].word) {
correctSound.currentTime = 0; correctSound.play();
spawnCoin(); fireworks();
resultText.innerText = "KACHING! BETUL! 💰";
resultText.style.color = "#2ed573";

score += 10;
currentLevel++;

// SAVE PROGRESS
localStorage.setItem('ai_score', score);
localStorage.setItem('ai_level', currentLevel);

setTimeout(() => {
if (currentLevel < gameData.length) {
loadLevel(currentLevel);
inputField.value = ""; resultText.innerText = "";
document.getElementById('score').innerText = score;
} else {
document.querySelector('#game-page .container').innerHTML = `<h1>🏆</h1><h2>JUARA AI!</h2><p>Markah: ${score}</p><button class="btn-main" onclick="resetGame()">MAIN SEMULA</button>`;
}
}, 1800);
} else {
wrongSound.currentTime = 0; wrongSound.play();
resultText.innerText = "Awhhh.. salah tu. 🙊";
resultText.style.color = "#ff4757";
document.getElementById('game-box').classList.add('shake');
setTimeout(() => document.getElementById('game-box').classList.remove('shake'), 500);
}
}

function showQuitPage() { document.getElementById('quit-page').style.display = 'flex'; }
function continueGame() { document.getElementById('quit-page').style.display = 'none'; }
function resetGame() { localStorage.clear(); location.reload(); }

function fireworks() {
var duration = 2.5 * 1000;
var animationEnd = Date.now() + duration;
var interval = setInterval(function() {
var timeLeft = animationEnd - Date.now();
if (timeLeft <= 0) return clearInterval(interval);
confetti({ particleCount: 40, origin: { x: Math.random(), y: Math.random() - 0.2 } });
}, 250);
}

function spawnCoin() {
const coin = document.createElement('div');
coin.className = 'coin-anim';
coin.innerText = '🪙';
document.body.appendChild(coin);
const startRect = document.getElementById('game-video').getBoundingClientRect();
coin.style.left = (startRect.left + startRect.width / 2 - 20) + 'px';
coin.style.top = (startRect.top + startRect.height / 2 - 20) + 'px';
const destRect = document.getElementById('score-container').getBoundingClientRect();
setTimeout(() => {
coin.style.left = destRect.left + 'px';
coin.style.top = destRect.top + 'px';
coin.style.transform = 'scale(0.3) rotate(1080deg)';
coin.style.opacity = '0';
}, 50);
setTimeout(() => {
document.getElementById('score-container').classList.add('bump');
setTimeout(() => document.getElementById('score-container').classList.remove('bump'), 200);
coin.remove();
}, 850);
}
document.getElementById('user-input').addEventListener('keypress', (e) => { if (e.key === 'Enter') checkAnswer(); });
</script>
</body>
</html>
