body {
background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
margin: 0; display: flex; justify-content: center; align-items: center;
min-height: 100vh; padding: 20px; overflow-x: hidden;
}
.container {
background: rgba(255, 255, 255, 0.98); padding: 30px 25px; border-radius: 40px;
box-shadow: 0 25px 50px rgba(0,0,0,0.3); max-width: 450px; width: 100%;
text-align: center; position: relative; border: 8px solid #ffffff;
animation: fadeIn 0.5s ease-out;
}
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
h1.brand { color: #6c5ce7; font-size: 32px; margin: 0 0 10px 0; letter-spacing: -1.5px; text-transform: uppercase; }

/* DASHBOARD & PROFILE */
.profile-main { margin-bottom: 20px; }
.avatar-circle { font-size: 60px; background: #eeebff; width: 100px; height: 100px; line-height: 100px; border-radius: 50%; margin: 0 auto 10px; border: 4px solid #6c5ce7; }
.player-name-big { font-size: 22px; font-weight: 600; color: #2d3436; margin-bottom: 20px; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px; }
.stat-card { background: #f1f2f6; padding: 15px; border-radius: 25px; border: 2px solid #fff; }
.stat-value { display: block; font-size: 24px; font-weight: 600; color: #2d3436; }
.stat-label { font-size: 11px; color: #636e72; text-transform: uppercase; font-weight: bold; }

/* BUTTONS */
.btn-main {
padding: 16px; background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
color: white; border: none; border-radius: 22px; cursor: pointer; font-size: 18px;
font-weight: bold; width: 100%; box-shadow: 0 8px 0 #4834d4; transition: 0.2s; margin-bottom: 12px; display: block;
}
.btn-main:active { transform: translateY(4px); box-shadow: 0 4px 0 #4834d4; }
.btn-alt { background: #b2bec3; box-shadow: 0 8px 0 #95a5a6; }

/* GAME ELEMENTS */
.header-game { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
.video-wrapper { width: 100%; border-radius: 30px; overflow: hidden; border: 6px solid #f1f2f6; margin-bottom: 15px; background: #000; }
video { width: 100%; display: block; }
input { padding: 16px; width: 100%; border: 3px solid #eee; border-radius: 20px; margin-bottom: 10px; font-size: 18px; text-align: center; outline: none; }

/* MODALS */
#quit-page, #reset-modal {
display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
background: rgba(45, 52, 54, 0.98); z-index: 1000; justify-content: center; align-items: center; padding: 20px; backdrop-filter: blur(10px);
}
.avatar-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 20px 0; }
.avatar-item { cursor: pointer; border-radius: 15px; border: 3px solid #eee; transition: 0.3s; padding: 10px; font-size: 30px; background: #fff; }
.avatar-item.selected { border-color: #6c5ce7; background: #eeebff; transform: scale(1.1); }

/* QUEST & HINT */
#game-question { font-size: 15px; font-weight: 600; color: #444; margin: 10px 0; line-height: 1.4; }
.hint-btn { background: #f1f2f6; border: 1px solid #ddd; padding: 6px 15px; border-radius: 12px; font-size: 12px; cursor: pointer; color: #666; margin-bottom: 10px; }
#hint-text { display: none; font-size: 12px; color: #6c5ce7; margin-bottom: 15px; font-style: italic; background: #eeebff; padding: 8px; border-radius: 10px; }

.hint-section { margin-top: 15px; background: #f8f9fa; padding: 10px; border-radius: 20px; }
.hint-list { display: flex; flex-wrap: wrap; gap: 5px; max-height: 50px; overflow-y: auto; padding: 5px; justify-content: center; }
.hint-item { background: #fff; padding: 3px 8px; border-radius: 8px; font-size: 11px; color: #7f8c8d; border: 1px solid #eee; }

.coin-anim { position: fixed; width: 45px; height: 45px; background: #ffd32a; border-radius: 50%; border: 4px solid #f0932b; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 20px; z-index: 9999; pointer-events: none; transition: all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
</style>
</head>
<body>

<!-- 1. STARTUP PAGE -->
<div id="startup-page" class="container" style="display: none;">
<h1 class="brand">JAGUH KOSA KATA</h1>
<p style="color: #636e72;">Daftar profil jaguh anda</p>
<input type="text" id="player-name" placeholder="Nama anda..." maxlength="12">
<div class="avatar-grid">
<div class="avatar-item selected" onclick="selectAvatar(this, '🤖')">🤖</div>
<div class="avatar-item" onclick="selectAvatar(this, '👨‍🚀')">👨‍🚀</div>
<div class="avatar-item" onclick="selectAvatar(this, '🥷')">🥷</div>
<div class="avatar-item" onclick="selectAvatar(this, '🦸‍♀️')">🦸‍♀️</div>
</div>
<button class="btn-main" onclick="saveAndStart()">JOM MULA 🚀</button>
</div>

<!-- 2. DASHBOARD PAGE -->
<div id="dashboard-page" class="container" style="display: none;">
<h1 class="brand">JAGUH KOSA KATA</h1>
<div class="profile-main">
<div class="avatar-circle" id="dash-avatar">🤖</div>
<div class="player-name-big" id="dash-name">Pemain</div>
</div>
<div class="stats-grid">
<div class="stat-card">
<span class="stat-value" id="dash-level">1</span>
<span class="stat-label">Level Semasa</span>
</div>
<div class="stat-card">
<span class="stat-value" id="dash-score">0</span>
<span class="stat-label">Koin Terkumpul</span>
</div>
</div>
<button class="btn-main" onclick="goToGame()">SAMBUNG MAIN 🔥</button>
<button class="btn-main btn-alt" onclick="openResetModal()">RESET & MULA BALIK</button>
</div>

<!-- 3. GAME PAGE -->
<div id="game-page" class="container" style="display: none;">
<div class="header-game">
<div style="display: flex; align-items: center; gap: 10px;">
<span id="game-avatar" style="font-size: 24px;">🤖</span>
<span id="game-name" style="font-weight: 600;">Pemain</span>
</div>
<div style="display: flex; align-items: center; gap: 8px;">
<div style="background: #ffd32a; padding: 5px 12px; border-radius: 15px; font-weight: bold;" id="score-container">💰 <span id="score">0</span></div>
<button onclick="showQuitPage()" style="background: #ff4757; color: white; border: none; border-radius: 50%; width: 30px; height: 30px; cursor: pointer; font-weight: bold;">✕</button>
</div>
</div>
<div style="font-size: 11px; color: #a29bfe; font-weight: bold;" id="level-text">LEVEL 1/20</div>

<p id="game-question">Soalan sedang dimuatkan...</p>

<div class="video-wrapper">
<video id="game-video" autoplay loop muted playsinline><source id="video-source" src="videos/menebar.mp4" type="video/mp4"></video>
</div>

<button class="hint-btn" onclick="showHint()">💡 Perlu Klu?</button>
<div id="hint-text">Klu muncul di sini</div>

<input type="text" id="user-input" placeholder="Teka jawapan..." autocomplete="off">
<button class="btn-main" onclick="checkAnswer()">HANTAR 🚀</button>
<p id="result" style="min-height: 25px; font-weight: bold; margin: 5px 0;"></p>
<div class="hint-section"><div class="hint-list" id="clue-list"></div></div>
</div>

<!-- 4. QUIT MODAL -->
<div id="quit-page">
<div class="container">
<h1 style="font-size: 60px; margin: 0;">🥺</h1>
<h2>Nak rehat ke?</h2>
<p>Progress anda tersimpan selamat.</p>
<button class="btn-main" onclick="continueGame()">SAMBUNG MAIN 🔥</button>
<button class="btn-main btn-alt" onclick="exitToDashboard()">KELUAR KE DASHBOARD</button>
</div>
</div>

<!-- 5. RESET MODAL -->
<div id="reset-modal">
<div class="container" style="border: 6px solid #ff4757;">
<h1 style="font-size: 50px; margin: 0;">⚠️</h1>
<h2>Reset Permainan?</h2>
<p style="color: #636e72; margin-bottom: 25px; line-height: 1.5;">Anda akan bermula semula dari <b>Level 1</b>. Koin dan level akan dipadamkan secara kekal.</p>
<button class="btn-main" onclick="confirmReset()" style="background: #ff4757; box-shadow: 0 8px 0 #b33939; margin-bottom: 12px;">YA, RESET SEKARANG</button>
<button class="btn-main btn-alt" onclick="closeResetModal()">TIDAK, TERUSKAN BERMAIN</button>
</div>
</div>

<audio id="snd-kaching" src="https://assets.mixkit.co/active_storage/sfx/2017/2017-preview.mp3"></audio>
<audio id="snd-aww" src="https://assets.mixkit.co/active_storage/sfx/251/251-preview.mp3"></audio>

<script>
let chosenAvatar = "🤖";
let score = 0;
let currentLevel = 0;

// DATA GAME LEVEL 1-20
const gameData = [
{ word: "menebar", vid: "videos/menebar.mp4", q: "Aksi apakah yang dilakukan oleh pemuda ini terhadap doh tersebut?", h: "Sering dilakukan oleh pakar roti canai." },
{ word: "memasak", vid: "videos/clip2.mp4", q: "Apakah aktiviti yang melibatkan kuali dan api ini?", h: "Proses menyediakan hidangan makanan." },
// Tambah soalan 3-20 ikut format kat atas
];
// Autofill placeholders untuk level 3-20
for (let i = 3; i <= 20; i++) {
gameData.push({ word: `jawapan${i}`, vid: `videos/clip${i}.mp4`, q: `Soalan Level ${i}: Teka aksi ini?`, h: `Klu untuk jawapan${i}` });
}

window.onload = function() {
const name = localStorage.getItem('jaguh_name');
if (name) { showDashboard(); } else { showPage('startup-page'); }
};

function showPage(id) {
['startup-page', 'dashboard-page', 'game-page', 'quit-page', 'reset-modal'].forEach(p => document.getElementById(p).style.display = 'none');
const el = document.getElementById(id);
if (id === 'quit-page' || id === 'reset-modal') el.style.display = 'flex';
else el.style.display = 'block';
}

function selectAvatar(el, avatar) {
document.querySelectorAll('.avatar-item').forEach(i => i.classList.remove('selected'));
el.classList.add('selected');
chosenAvatar = avatar;
}

function saveAndStart() {
const name = document.getElementById('player-name').value.trim();
if (!name) return alert("Nama jangan kosong bro!");
localStorage.setItem('jaguh_name', name);
localStorage.setItem('jaguh_avatar', chosenAvatar);
localStorage.setItem('jaguh_level', 0);
localStorage.setItem('jaguh_score', 0);
goToGame();
}

function showDashboard() {
document.getElementById('dash-name').innerText = localStorage.getItem('jaguh_name');
document.getElementById('dash-avatar').innerText = localStorage.getItem('jaguh_avatar');
document.getElementById('dash-level').innerText = parseInt(localStorage.getItem('jaguh_level')) + 1;
document.getElementById('dash-score').innerText = localStorage.getItem('jaguh_score');
showPage('dashboard-page');
}

function goToGame() {
currentLevel = parseInt(localStorage.getItem('jaguh_level')) || 0;
score = parseInt(localStorage.getItem('jaguh_score')) || 0;
document.getElementById('game-name').innerText = localStorage.getItem('jaguh_name');
document.getElementById('game-avatar').innerText = localStorage.getItem('jaguh_avatar');
document.getElementById('score').innerText = score;
loadLevel(currentLevel);
initClues();
showPage('game-page');
}

function loadLevel(idx) {
if(idx >= gameData.length) return;
document.getElementById('level-text').innerText = `LEVEL ${idx + 1}/20`;
document.getElementById('game-question').innerText = gameData[idx].q;
document.getElementById('hint-text').innerText = "Klu: " + gameData[idx].h;
document.getElementById('hint-text').style.display = 'none';

const video = document.getElementById('game-video');
document.getElementById('video-source').src = gameData[idx].vid;
video.load();
}

function showHint() { document.getElementById('hint-text').style.display = 'block'; }

function initClues() {
const list = document.getElementById('clue-list');
list.innerHTML = "";
gameData.forEach(d => {
let s = document.createElement('span'); s.className = 'hint-item'; s.innerText = d.word; list.appendChild(s);
});
}

function checkAnswer() {
const input = document.getElementById('user-input');
const res = document.getElementById('result');
if (input.value.toLowerCase().trim() === gameData[currentLevel].word) {
document.getElementById('snd-kaching').play();
spawnCoin(); fireworks();
res.innerText = "BETUL! 💰"; res.style.color = "#2ed573";
score += 10; currentLevel++;
localStorage.setItem('jaguh_score', score);
localStorage.setItem('jaguh_level', currentLevel);
setTimeout(() => {
if (currentLevel < gameData.length) { loadLevel(currentLevel); input.value = ""; res.innerText = ""; document.getElementById('score').innerText = score; }
else { alert("TAHNIAH! ANDA JAGUH KOSA KATA!"); exitToDashboard(); }
}, 1500);
} else {
document.getElementById('snd-aww').play();
res.innerText = "SALAH! 🙊"; res.style.color = "#ff4757";
}
}

function showQuitPage() { document.getElementById('quit-page').style.display = 'flex'; }
function continueGame() { document.getElementById('quit-page').style.display = 'none'; closeResetModal(); }
function exitToDashboard() { showDashboard(); }
function openResetModal() { document.getElementById('reset-modal').style.display = 'flex'; }
function closeResetModal() { document.getElementById('reset-modal').style.display = 'none'; }
function confirmReset() { localStorage.clear(); location.reload(); }

function fireworks() {
let end = Date.now() + 2000;
(function frame() {
confetti({ particleCount: 5, angle: 60, spread: 55, origin: { x: 0 } });
confetti({ particleCount: 5, angle: 120, spread: 55, origin: { x: 1 } });
if (Date.now() < end) requestAnimationFrame(frame);
}());
}

function spawnCoin() {
const coin = document.createElement('div'); coin.className = 'coin-anim'; coin.innerText = '🪙';
document.body.appendChild(coin);
const v = document.getElementById('game-video').getBoundingClientRect();
coin.style.left = (v.left + v.width/2 - 20) + 'px'; coin.style.top = (v.top + v.height/2 - 20) + 'px';
const d = document.getElementById('score-container').getBoundingClientRect();
setTimeout(() => { coin.style.left = d.left + 'px'; coin.style.top = d.top + 'px'; coin.style.transform = 'scale(0.2)'; coin.style.opacity = '0'; }, 50);
setTimeout(() => coin.remove(), 800);
}
document.getElementById('user-input').addEventListener('keypress', (e) => { if (e.key === 'Enter') checkAnswer(); });
</script>
</body>
</html>
