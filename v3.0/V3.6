<div class="header-info">
<div class="user-profile">
<span id="display-avatar">🤖</span>
<span id="display-name">Player</span>
</div>
<div style="display: flex; gap: 8px; align-items: center;">
<div class="score-box" id="score-container">💰 <span id="score">0</span></div>
<button class="btn-quit" onclick="showQuitPage()">X</button>
</div>
</div>
<div id="level-text" style="font-size: 12px; margin-bottom: 10px; font-weight: bold; color: #666;">LEVEL 1/20</div>
