.score-box.bump { transform: scale(1.2); }
.btn-quit { background: #ff4757; color: white; border: none; border-radius: 50%; width: 35px; height: 35px; cursor: pointer; font-weight: bold; box-shadow: 0 4px 0 #b33939; }

.video-wrapper { width: 100%; border-radius: 30px; overflow: hidden; border: 6px solid #fff; margin-bottom: 20px; background: #000; }
video { width: 100%; display: block; }

input { padding: 18px; width: 100%; border: 3px solid #eee; border-radius: 20px; margin-bottom: 15px; font-size: 18px; text-align: center; outline: none; }

.btn-main {
padding: 18px; background: #6c5ce7; color: white; border: none; border-radius: 20px;
cursor: pointer; font-size: 20px; font-weight: bold; width: 100%;
box-shadow: 0 8px 0 #4834d4; transition: 0.2s;
}
.btn-main:active { transform: translateY(4px); box-shadow: 0 4px 0 #4834d4; }

/* 3. QUIT PAGE (OVERLAY) */
#quit-page {
display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
background: rgba(0,0,0,0.9); z-index: 1000; justify-content: center; align-items: center; padding: 20px;
}

.hint-section { margin-top: 20px; background: #f1f2f6; padding: 15px; border-radius: 20px; }
.hint-list { display: flex; flex-wrap: wrap; gap: 8px; max-height: 60px; overflow-y: auto; padding: 5px; }
.hint-item { background: #fff; padding: 4px 10px; border-radius: 10px; font-size: 12px; color: #666; border: 1px solid #ddd; }

.coin-anim {
position: fixed; width: 45px; height: 45px; background: #ffd32a;
border-radius: 50%; border: 4px solid #f0932b; color: white;
display: flex; align-items: center; justify-content: center;
font-weight: bold; font-size: 20px; z-index: 9999;
pointer-events: none; transition: all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
#result { margin-top: 15px; font-size: 20px; font-weight: bold; min-height: 30px; }
