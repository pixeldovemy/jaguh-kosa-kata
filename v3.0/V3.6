}
button:active { transform: translateY(4px); box-shadow: 0 4px 0 #4834d4; }
.hint-section { margin-top: 20px; background: #f1f2f6; padding: 15px; border-radius: 20px; border: 2px dashed #ccc; }
.hint-list { display: flex; flex-wrap: wrap; gap: 8px; max-height: 80px; overflow-y: auto; padding: 5px; scrollbar-width: thin; }
.hint-item { background: #fff; padding: 5px 12px; border-radius: 12px; font-size: 13px; color: #666; border: 1px solid #ddd; }
.coin-anim {
position: fixed; width: 45px; height: 45px; background: #ffd32a;
border-radius: 50%; border: 4px solid #f0932b; color: white;
display: flex; align-items: center; justify-content: center;
font-weight: bold; font-size: 20px; z-index: 9999;
pointer-events: none; transition: all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}
