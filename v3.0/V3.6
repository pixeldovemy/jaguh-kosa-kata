<style>
* { box-sizing: border-box; font-family: 'Fredoka', sans-serif; }
body {
background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
margin: 0; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px;
overflow: hidden;
}
.container {
background: rgba(255, 255, 255, 0.9); padding: 25px; border-radius: 40px;
box-shadow: 0 20px 40px rgba(0,0,0,0.1); max-width: 500px; width: 100%; text-align: center;
position: relative; border: 8px solid #fff;
}
.header-info { display: flex; justify-content: space-between; margin-bottom: 20px; align-items: center; }

#level-text { background: #6c5ce7; color: white; padding: 8px 15px; border-radius: 20px; font-size: 14px; }

/* Box Markah / Coin Container */
.score-box {
background: #ffd32a; padding: 8px 20px; border-radius: 20px;
font-size: 16px; font-weight: bold; display: flex; align-items: center; gap: 8px;
transition: transform 0.2s;
}
.score-box.bump { transform: scale(1.2); }

.video-wrapper { width: 100%; border-radius: 30px; overflow: hidden; border: 6px solid #fff; margin-bottom: 20px; background: #000; box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
video { width: 100%; display: block; }

input { padding: 18px; width: 100%; border: 3px solid #eee; border-radius: 20px; margin-bottom: 15px; font-size: 18px; text-align: center; outline: none; transition: 0.3s; }
input:focus { border-color: #6c5ce7; background: #fff; }

button {
padding: 18px; background: #6c5ce7; color: white; border: none; border-radius: 20px;
cursor: pointer; font-size: 20px; font-weight: bold; width: 100%;
box-shadow: 0 10px 0 #4834d4; transition: 0.2s;
}
button:active { transform: translateY(5px); box-shadow: 0 5px 0 #4834d4; }

/* Hint Box */
.hint-section { margin-top: 20px; background: #f1f2f6; padding: 15px; border-radius: 20px; }
.hint-list { display: flex; flex-wrap: wrap; gap: 8px; max-height: 80px; overflow-y: auto; padding: 5px; }
.hint-item { background: #fff; padding: 5px 12px; border-radius: 12px; font-size: 13px; color: #666; border: 1px solid #ddd; }

/* Animasi Coin Terbang */
.coin-anim {
position: fixed; width: 40px; height: 40px; background: #ffd32a;
border-radius: 50%; border: 4px solid #f0932b; color: #fff;
display: flex; align-items: center; justify-content: center;
font-weight: bold; font-size: 20px; z-index: 9999;
pointer-events: none; transition: all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

#result { margin-top: 15px; font-size: 20px; font-weight: bold; min-height: 30px; }
</style>
</head>
<body>

<div class="container" id="game-box">
<div class="header-info">
<div id="level-text">LEVEL 1/20</div>
<div class="score-box" id="score-container">💰 <span id="score">0</span></div>
</div>

<div class="video-wrapper">
<video id="game-video" autoplay loop muted playsinline>
<source id="video-source" src="videos/clip1.mp4" type="video/mp4">
</video>
</div>

<input type="text" id="user-input" placeholder="Teka jawapan..." autocomplete="off">
<button onclick="checkAnswer()">HANTAR 🚀</button>
<p id="result"></p>

<div class="hint-section">
<div class="hint-list" id="clue-list"></div>
</div>
</div>

<script>
// Audio Resources
const clapSound = new Audio('https://assets.mixkit.co/active_storage/sfx/2013/2013-preview.mp3');
const sadSound = new Audio('https://assets.mixkit.co/active_storage/sfx/251/251-preview.mp3');

const gameData = [];
for (let i = 1; i <= 20; i++) {
gameData.push({ word: `jawapan${i}`, vid: `videos/clip${i}.mp4` });
}

let currentLevel = 0;
let score = 0;

// Hint List Generator
const clueList = document.getElementById('clue-list');
gameData.forEach(item => {
let span = document.createElement('span');
span.className = 'hint-item';
span.innerText = item.word;
clueList.appendChild(span);
});

function checkAnswer() {
const inputField = document.getElementById('user-input');
const resultText = document.getElementById('result');
const videoElement = document.getElementById('game-video');

let answer = inputField.value.toLowerCase().trim();

if (answer === gameData[currentLevel].word) {
// BETUL - Trigger Coin & Confetti
spawnCoin();
clapSound.play();

// Confetti Meriah (3 bursts)
let duration = 2 * 1000;
let end = Date.now() + duration;

(function frame() {
confetti({ particleCount: 3, angle: 60, spread: 55, origin: { x: 0 } });
confetti({ particleCount: 3, angle: 120, spread: 55, origin: { x: 1 } });
if (Date.now() < end) { requestAnimationFrame(frame); }
}());

resultText.innerText = "TEPAT SEKALI! 🌟";
resultText.style.color = "#2ed573";

setTimeout(() => {
currentLevel++;
if (currentLevel < gameData.length) {
document.getElementById('level-text').innerText = `LEVEL ${currentLevel + 1}/20`;
document.getElementById('video-source').src = gameData[currentLevel].vid;
videoElement.load();
videoElement.play();
inputField.value = "";
resultText.innerText = "";
} else {
document.querySelector('.container').innerHTML = `<h1>🏆</h1><h2>MAHARAJA AI!</h2><p>Markah Akhir: ${score}</p><button onclick="location.reload()">MAIN SEMULA</button>`;
}
}, 1500);

} else {
// SALAH - Bunyi Kecewa
sadSound.play();
resultText.innerText = "Bukan tu.. Cuba lagi! 🙊";
resultText.style.color = "#ff4757";
}
}

// Fungsi Coin Terbang
function spawnCoin() {
const coin = document.createElement('div');
coin.className = 'coin-anim';
coin.innerText = '+$';
document.body.appendChild(coin);

// Start position (Tengah video)
const startRect = document.getElementById('game-video').getBoundingClientRect();
const startX = startRect.left + (startRect.width / 2) - 20;
const startY = startRect.top + (startRect.height / 2) - 20;

coin.style.left = startX + 'px';
coin.style.top = startY + 'px';

// Destination (Kotak Markah)
const destRect = document.getElementById('score-container').getBoundingClientRect();

setTimeout(() => {
coin.style.left = destRect.left + 'px';
coin.style.top = destRect.top + 'px';
coin.style.transform = 'scale(0.2)';
coin.style.opacity = '0';
}, 50);

setTimeout(() => {
score += 10;
document.getElementById('score').innerText = score;
document.getElementById('score-container').classList.add('bump');
setTimeout(() => document.getElementById('score-container').classList.remove('bump'), 200);
coin.remove();
}, 850);
}

document.getElementById('user-input').addEventListener('keypress', (e) => { if (e.key === 'Enter') checkAnswer(); });
</script>

</body>
</html>
