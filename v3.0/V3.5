    <!-- 4. GAME PAGE -->
    <div id="game-page" class="container" style="display: none;">
        <div class="header-game">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span id="game-avatar" style="font-size: 20px;">🤖</span>
                <span id="game-name" style="font-weight:600; font-size:14px;">Pemain</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <div style="background: #ffd32a; padding: 4px 10px; border-radius: 12px; font-weight: bold; font-size: 13px;" id="score-container">💰 <span id="score">0</span></div>
                <button onclick="showQuitPage()" style="background: #ff4757; color: white; border: none; border-radius: 50%; width: 28px; height: 28px; cursor: pointer;">✕</button>
            </div>
        </div>
        <p id="game-question" style="font-size:14px; font-weight:bold; margin-bottom:10px;">Loading...</p>
