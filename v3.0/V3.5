<body>

    <!-- 1. STARTUP PAGE -->
    <div id="startup-page" class="container" style="display: none;">
        <h1 class="brand">JAGUH KOSA KATA</h1>
        <p style="color: #636e72; font-size: 14px;">Daftar profil jaguh anda</p>
        <input type="text" id="player-name" placeholder="Nama anda..." maxlength="12">
        <div class="avatar-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 20px 0;">
            <div class="avatar-item" style="cursor:pointer; font-size:30px;" onclick="selectAvatar(this, '🤖')">🤖</div>
            <div class="avatar-item" style="cursor:pointer; font-size:30px;" onclick="selectAvatar(this, '👨‍🚀')">👨‍🚀</div>
            <div class="avatar-item" style="cursor:pointer; font-size:30px;" onclick="selectAvatar(this, '🥷')">🥷</div>
            <div class="avatar-item" style="cursor:pointer; font-size:30px;" onclick="selectAvatar(this, '🦸‍♀️')">🦸‍♀️</div>
        </div>
        <button class="btn-main" onclick="saveAndStart()">JOM MULA 🚀</button>
    </div>

    <!-- 2. DASHBOARD PAGE -->
    <div id="dashboard-page" class="container" style="display: none;">
        <h1 class="brand">PROFIL JAGUH</h1>
        <div class="avatar-circle" id="dash-avatar">🤖</div>
        <div style="font-size: 20px; font-weight: 600;" id="dash-name">Pemain</div>
        <div id="dash-gelaran" class="rank-badge">PELAJAR TEKUN 🎓</div>
        <div class="stats-grid">
            <div class="stat-card"><span class="stat-value" id="dash-level">1</span><span class="stat-label">Level</span></div>
            <div class="stat-card"><span class="stat-value" id="dash-score">0</span><span class="stat-label">Koin</span></div>
        </div>
        <button class="btn-main" onclick="showMap()">SAMBUNG MAIN 🔥</button>
        <button class="btn-main btn-alt" onclick="openResetModal()">RESET</button>
    </div>

    <!-- 3. LEVEL MAP PAGE -->
    <div id="map-page-container" class="container" style="display: none;">
        <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <button onclick="showDashboard()" style="background:none; border:none; color:#6c5ce7; font-weight:bold; cursor:pointer;">← KEMBALI</button>
            <h1 class="brand" style="margin:0; font-size:20px;">PETA LEVEL</h1>
            <div style="width:50px;"></div>
        </div>
        <div id="map-page">
            <!-- Level Grid Rendered by JS -->
        </div>
